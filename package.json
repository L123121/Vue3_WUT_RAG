{
  "name": "wut-rag-copilot",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "src/main.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cd backend && npm start",
    "lint": "eslint src/ backend/src/ backend/__tests__/ --fix",
    "lint:check": "eslint src/ backend/src/ backend/__tests__/",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,vue}\" \"backend/{src,__tests__}/**/*.js\"",
    "test": "node scripts/run-test-suites.mjs fast",
    "test:all": "node scripts/run-test-suites.mjs all",
    "test:frontend": "node scripts/run-test-suites.mjs frontend",
    "test:backend": "node scripts/run-test-suites.mjs backend",
    "test:integration": "node scripts/run-test-suites.mjs integration",
    "eval:rag-baseline": "node backend/scripts/rag-eval/eval-baseline.mjs",
    "eval:corpus-check": "node scripts/rag-eval/verify-corpus.mjs",
    "eval:corpus-migrate": "node scripts/rag-eval/migrate-dataset-docids.cjs --write",
    "test:watch": "vitest --pool=threads --maxWorkers=1",
    "postinstall": "cd backend && npm install",
    "eval:ragas": "cd scripts/rag-eval && npm run eval:ragas",
    "eval:ragas:export": "cd scripts/rag-eval && npm run eval:ragas:export",
    "eval:parent-rerank:collect": "node scripts/rag-eval/collect-parent-rerank-eval.js",
    "eval:parent-rerank": "node scripts/rag-eval/eval-parent-rerank.js",
    "rag:import-test-doc": "cd scripts/rag-eval && npm run docs:import-test",
    "eval:ragas:discrete": "cd scripts/rag-eval && npm run eval:ragas:discrete"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.344.0",
    "markdown-it": "^15.0.0",
    "pinia": "2.1.7",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "web-vitals": "^5.3.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.14.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.19.8",
    "@vitejs/plugin-vue": "^5.2.2",
    "@vue/compiler-sfc": "^3.5.27",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.11"
  }
}
