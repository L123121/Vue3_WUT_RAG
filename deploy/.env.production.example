# ======================================================================
# 武理小精灵 — 生产环境变量模板
# 部署前复制为 .env.production 并填入真实值
# ======================================================================

# ---------- 服务器 ----------
PORT=3000
NODE_ENV=production
# 反向代理层数：未声明时 express 认为没有代理，限流会把所有客户端算成一个 IP。
# 默认 1（nginx 直连）；多级代理/CDN 按实际层数调整。
TRUST_PROXY_HOPS=1

# ---------- AI 模型服务（阶跃星辰 StepFun / OpenAI 兼容 API） ----------
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.stepfun.com/v1
AI_MODEL=step-3.7-flash
AI_CONTEXT_MAX_CHARS=12000
AI_CONTEXT_MESSAGE_MAX_CHARS=4000
# LLM 并发与背压：控制同时请求数，并限制排队规模/等待时间
LLM_CONCURRENCY=3
LLM_MAX_PENDING=20
LLM_QUEUE_TIMEOUT_MS=15000

# ---------- StepFun 语音合成（可选） ----------
# 主模型不是 StepFun 时必须单独设置 STEPFUN_API_KEY
# STEPFUN_API_KEY=your_stepfun_api_key_here
# Step Plan 场景使用 https://api.stepfun.com/step_plan/v1；普通开放平台使用 https://api.stepfun.com/v1
STEPFUN_AUDIO_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
STEPFUN_TTS_VOICE=cixingnansheng
STEPFUN_TTS_FORMAT=mp3
STEPFUN_TTS_SPEED=1
STEPFUN_TTS_INSTRUCTION=自然、亲切、清晰，像校园里的学长学姐耐心回答问题
STEPFUN_TTS_MAX_AUDIO_BYTES=16777216
STEPFUN_TTS_CACHE_ENABLED=true
STEPFUN_TTS_CACHE_TTL_MS=1800000
STEPFUN_TTS_CACHE_MAX_ENTRIES=100
STEPFUN_TTS_CACHE_MAX_BYTES=67108864

# ---------- 运营监控持久化 ----------
OPS_TIMEZONE=Asia/Shanghai
OPS_METRICS_PERSISTENCE=true
OPS_METRICS_PERSIST_INTERVAL_MS=5000
# Prometheus 抓取端点（建议只监听内网并设置强 token）
METRICS_PROMETHEUS_ENABLED=false
# METRICS_PROMETHEUS_TOKEN=change_me_scrape_token
# RunEvent 结构化回放日志默认关闭；开启后默认不保存回答正文
RUN_EVENT_LOG_ENABLED=false
RUN_EVENT_LOG_INCLUDE_CONTENT=false
# RUN_EVENT_LOG_PATH=/app/backend/data/run-events.jsonl
# RUN_EVENT_LOG_MAX_BYTES=33554432
# RUN_EVENT_LOG_MAX_RUNS=500
# RUN_EVENT_LOG_MAX_EVENTS_PER_RUN=1000

# ---------- LLM-as-judge 评测专用（独立 Key，不跟生产抢配额） ----------
# 不设置则默认使用 AI_API_KEY
# JUDGE_API_KEY=your_judge_api_key_here
# JUDGE_MODEL=step-3.5-flash

# ---------- 本地 Embedding（BGE-small-zh） ----------
EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=/app/.model-cache
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_SPARSE_DIM=250002

# ---------- 向量库与 RAG 检索 ----------
# 使用 docker-compose.yml 部署时，QDRANT_URL 已由 compose 的
# environment 注入（qdrant 服务），此处无需重复设置；单机直跑时再取消注释
# QDRANT_URL=http://qdrant:6333
# QDRANT_COLLECTION=wuli_elf_chunks
RAG_VECTOR_TOP_K=50
RAG_RERANK_TOP_K=10
RAG_MAX_CONTEXT_LENGTH=6000
RAG_MIN_SOURCE_SCORE=0.03
# 运行时引用校验（防幻觉兜底）：生成后逐句对照 RAG 上下文，低溯源回答标注
RAG_GROUNDING_ENABLED=true
RAG_GROUNDING_MIN_SUPPORT=0.35
# faithfulness 硬门禁：off=仅标注（默认） / warn=低溯源回答发警示条 / enforce=低溯源回答拦截替换拒答文案
# RAG_FAITHFULNESS_GATE=off
# RAG_FAITHFULNESS_GATE_MIN_COVERAGE=0.35
RAG_WIKI_FIRST_ENABLED=true
RAG_WIKI_HYBRID_ENABLED=true
RAG_WIKI_FIRST_MAX_ENTRIES=3

# ---------- Jev System One 决策路由（默认关闭） ----------
# 先 shadow，再 canary；只有配置 API Key 后才会发起外部请求
JEV_DECISION_ENABLED=false
JEV_DECISION_MODE=off
# JEV_API_KEY=your_typesafe_api_key
# TYPESAFE_API_KEY=your_typesafe_api_key
JEV_DECISION_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_DECISION_MODEL=jev-latest
JEV_DECISION_TIMEOUT_MS=1200
JEV_DECISION_MAX_RETRIES=1
JEV_DECISION_MIN_CONFIDENCE=0.55
JEV_DECISION_ROLLOUT_PERCENT=0
JEV_DECISION_INCLUDE_HISTORY=false
JEV_DECISION_POLICY_VERSION=route-v1

# ---------- Agent 工具与上下文工件 ----------
AGENT_TOOL_ENABLED=true
AGENT_CONTEXT_COMPACTION=true
AGENT_TOOL_RESULT_SPILL_THRESHOLD=2000
AGENT_TOOL_RESULT_KEEP_ROUNDS=1
AGENT_TOOL_SPILL_TTL_MS=3600000
AGENT_TOOL_SPILL_MAX_BYTES=67108864
AGENT_TOOL_SPILL_MAX_FILES=200
AGENT_MAX_TOOL_CALLS_PER_ROUND=4

# ---------- Agentic RAG（默认关闭，先灰度验证） ----------
AGENTIC_RAG_ENABLED=false
AGENTIC_RAG_MAX_ROUNDS=2
AGENTIC_RAG_MAX_DURATION_MS=20000
AGENTIC_RAG_REWRITE_TIMEOUT_MS=8000
AGENTIC_RAG_MIN_SOURCES=1

# ---------- 数据库（PostgreSQL，可选） ----------
# 默认使用 SQLite（backend-data volume 持久化，无需配置）。
# 如需切换 PostgreSQL，设置 DATABASE_URL 并自行部署 postgres 实例
# （当前 docker-compose.yml 不包含 postgres 服务）：
# DATABASE_URL=postgres://wuli:wuli123456@postgres:5432/wuli_elf

# ---------- 请求级 LLM 成本硬门禁（超限后该请求后续 LLM 调用 fail-closed） ----------
# 默认阈值宽松，只拦截失控循环（正常最重请求 ≈ 6-8 次调用）
COST_GATE_ENABLED=true
COST_GATE_MAX_LLM_CALLS=16
COST_GATE_MAX_TOTAL_TOKENS=120000

# ---------- 后台任务 ----------
# SQLITE_DB_PATH=/app/backend/data/store.db
# JOB_POLL_INTERVAL_MS=1000
# JOB_RETENTION_DAYS=30
# JOB_PRUNE_INTERVAL_MS=3600000
# JOB_QUEUE_BACKEND=sqlite
# JOB_RUNNER_ENABLED=false
# JOB_SCHEDULER_ENABLED=false

# ---------- Redis 共享协调层 ----------
# docker-compose 会为 API / Worker 注入 REDIS_URL=redis://redis:6379/0
# REDIS_TIMEOUT_MS=1500
# REDIS_JOBS_CHANNEL=wut:jobs:available

# ---------- RAG 发布质量门禁 ----------
# 配置 RAG_EVAL_ENABLED=true 后，deploy workflow 会执行线上检索基线和质量门禁。
# RAG_GATE_MIN_RECALL5=0.80
# RAG_GATE_MAX_REGRESSION=0.05

# ---------- JWT 密钥（生产环境务必改为随机 64 位字符串） ----------
JWT_SECRET=your-random-64-char-secret-here-change-in-production

# ---------- CORS（生产环境必填，填写前端域名白名单） ----------
# 多个域名用英文逗号分隔，例如：https://a.example.com,https://b.example.com
# 该白名单同时用于 CSRF 的 Origin/Referer 同源校验（非安全方法必校验），
# 必须与前端实际域名一致，否则写操作会被 403 拒绝。
CORS_ORIGIN=https://your-domain.com

# ---------- 容器资源上限（docker-compose 读取） ----------
# 单机部署务必设置：backend 同进程跑 embedding/reranker/LLM 并发，
# 与 qdrant 争抢内存会整机 OOM。按机器规格调整。
# BACKEND_CPU_LIMIT=3.0
# BACKEND_MEM_LIMIT=3g
# QDRANT_CPU_LIMIT=2.0
# QDRANT_MEM_LIMIT=3g

# ---------- CDN 加速（可选） ----------
# 设置后前端静态资源（JS/CSS/图片）的引用地址会改为 CDN 域名
# 需要先配置 CDN 回源到后端服务，然后设置此地址
# 例如：VITE_CDN_URL=https://static.your-domain.com
# 不设置则使用默认路径 /
