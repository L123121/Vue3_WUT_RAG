# ========== Redis（可选，不填则使用本地内存存储） ==========

# ========== 服务器 ==========
PORT=3000
NODE_ENV=production

# ========== 运营监控与成本估算（不填单价则只统计 token/字符） ==========
OPS_ALERT_ERROR_RATE=0.1
OPS_ALERT_P95_MS=3000
OPS_ALERT_DAILY_COST_CNY=100
OPS_TIMEZONE=Asia/Shanghai
OPS_METRICS_PERSISTENCE=true
OPS_METRICS_PERSIST_INTERVAL_MS=5000
# LLM 并发与背压：满载时最多排队 20 个，单个 waiter 最多等 15 秒
LLM_CONCURRENCY=3
LLM_MAX_PENDING=20
LLM_QUEUE_TIMEOUT_MS=15000
AI_INPUT_COST_CNY_PER_MILLION=0
AI_OUTPUT_COST_CNY_PER_MILLION=0
TTS_COST_CNY_PER_10K_CHARS=0
# Prometheus 抓取端点默认关闭；生产环境启用时务必设置 token
METRICS_PROMETHEUS_ENABLED=false
# METRICS_PROMETHEUS_TOKEN=change_me_scrape_token
# RunEvent 结构化回放日志默认关闭；开启后默认不保存回答正文
RUN_EVENT_LOG_ENABLED=false
RUN_EVENT_LOG_INCLUDE_CONTENT=false
# RUN_EVENT_LOG_PATH=../data/run-events.jsonl
# RUN_EVENT_LOG_MAX_BYTES=33554432
# RUN_EVENT_LOG_MAX_RUNS=500
# RUN_EVENT_LOG_MAX_EVENTS_PER_RUN=1000

# ========== 隐私留存（后台定期清理到期数据，0 = 不自动删除） ==========
# RUN_EVENT_LOG_RETENTION_DAYS=30
# SHARE_SNAPSHOT_RETENTION_DAYS=0
# CONVERSATION_RETENTION_DAYS=0
# PRIVACY_SWEEP_INTERVAL_MS=86400000

# ========== AI 模型服务（OpenAI-compatible 通义千问 / 讯飞 MaaS） ==========
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com
AI_MODEL=xopqwen36v35b
# provider 入口上下文预算（字符近似，Agent opts.messages 同样受限）
AI_CONTEXT_MAX_CHARS=12000
AI_CONTEXT_MESSAGE_MAX_CHARS=4000

# ========== StepFun 语音合成（可选） ==========
# 主模型不是 StepFun 时必须单独配置；主模型已经使用 StepFun 时可复用 AI_API_KEY
# STEPFUN_API_KEY=your_stepfun_api_key_here
STEPFUN_AUDIO_BASE_URL=https://api.stepfun.com/v1
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
STEPFUN_TTS_VOICE=cixingnansheng
STEPFUN_TTS_FORMAT=mp3
STEPFUN_TTS_SPEED=1
STEPFUN_TTS_INSTRUCTION=自然、亲切、清晰，像校园里的学长学姐耐心回答问题
STEPFUN_TTS_MAX_AUDIO_BYTES=16777216
# TTS 内存缓存：默认 30 分钟、100 条、64MB
STEPFUN_TTS_CACHE_ENABLED=true
STEPFUN_TTS_CACHE_TTL_MS=1800000
STEPFUN_TTS_CACHE_MAX_ENTRIES=100
STEPFUN_TTS_CACHE_MAX_BYTES=67108864

# ---------- 备用 AI Provider（可选，主 provider 失败时自动切换） ----------
# 推荐：LongCat（支持 OpenAI 格式）
AI_FALLBACK_API_KEY=your_fallback_api_key_here
AI_FALLBACK_BASE_URL=https://api.longcat.chat/openai
AI_FALLBACK_MODEL=LongCat-2.0
# AI_FALLBACK_MAX_TOKENS=4000
# AI_FALLBACK_TEMPERATURE=0.7
# AI_FALLBACK_TIMEOUT=60000

# ========== LLM-as-judge 评测专用（独立 Key，不跟生产抢配额） ==========
# JUDGE_API_KEY=your_judge_api_key_here
# JUDGE_MODEL=step-3.5-flash

# ========== 本地 Embedding（BGE-small-zh） ==========
EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=../.model-cache
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_SPARSE_DIM=250002

# ========== Qdrant 向量数据库（唯一向量后端） ==========
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=wuli_elf_chunks
# 标量量化（QDRANT_QUANTIZATION=int8）：向量内存约省 75%，需重建 collection 后全量生效
# QDRANT_QUANTIZATION=int8

# ========== RAG 检索 ==========
RAG_HYBRID_SEARCH=true
RAG_VECTOR_TOP_K=50
RAG_RERANK_TOP_K=10
RAG_VECTOR_WEIGHT=0.6
RAG_SPARSE_WEIGHT=0.4
RAG_MIN_SOURCE_SCORE=0.03
RAG_WIKI_FIRST_ENABLED=true
RAG_WIKI_HYBRID_ENABLED=true
RAG_WIKI_FIRST_MAX_ENTRIES=3

# ========== Wiki 编译期互链（词条上架时 LLM 梳理相关词条，默认开启） ==========
WIKI_RELATION_COMPILE_ENABLED=true
WIKI_RELATION_MAX_CANDIDATES=20
WIKI_RELATION_MAX_RELATED=5
WIKI_RELATION_TIMEOUT_MS=8000

# 语义缓存：精确缓存 miss 后按查询向量余弦相似度复用近义问题的检索候选池
# （reranker 仍按原始问题打分，共享召回池不影响精度）
RAG_SEMANTIC_CACHE_ENABLED=false
# RAG_SEMANTIC_CACHE_THRESHOLD=0.95
# RAG_SEMANTIC_CACHE_MAX_ENTRIES=200

# ========== Jev System One 决策路由（默认关闭） ==========
# 官方 API：POST https://api.typesafe.ai/v1/systemone
# 首次建议 shadow：只记录与旧 IntentRouter 的分歧，不改变线上路由
JEV_DECISION_ENABLED=false
JEV_DECISION_MODE=off
# JEV_API_KEY=your_typesafe_api_key
# 或使用官方环境变量：TYPESAFE_API_KEY=your_typesafe_api_key
JEV_DECISION_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_DECISION_MODEL=jev-latest
JEV_DECISION_TIMEOUT_MS=1200
JEV_DECISION_MAX_RETRIES=1
JEV_DECISION_MIN_CONFIDENCE=0.55
JEV_DECISION_ROLLOUT_PERCENT=0
JEV_DECISION_INCLUDE_HISTORY=false
JEV_DECISION_POLICY_VERSION=route-v1

# ========== Agent 工具与上下文工件 ==========
AGENT_TOOL_ENABLED=true
AGENT_CONTEXT_COMPACTION=true
AGENT_TOOL_RESULT_SPILL_THRESHOLD=2000
AGENT_TOOL_RESULT_KEEP_ROUNDS=1
AGENT_TOOL_SPILL_TTL_MS=3600000
AGENT_TOOL_SPILL_MAX_BYTES=67108864
AGENT_TOOL_SPILL_MAX_FILES=200
AGENT_MAX_TOOL_CALLS_PER_ROUND=4

# ========== Agentic RAG（默认关闭，建议灰度启用） ==========
AGENTIC_RAG_ENABLED=false
AGENTIC_RAG_MAX_ROUNDS=2
AGENTIC_RAG_MAX_DURATION_MS=20000
AGENTIC_RAG_REWRITE_TIMEOUT_MS=8000
AGENTIC_RAG_MIN_SOURCES=1

# ========== JWT（必须设置，用于用户认证） ==========
JWT_SECRET=change_me_to_a_long_random_string

# ========== 自有账号注册（可选，不填则不校验邀请码） ==========
AUTH_INVITE_CODE=change_me_invite_code

# ========== 管理员登录（不依赖教务系统） ==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here
